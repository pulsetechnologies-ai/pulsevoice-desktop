{
  "name": "pulsevoice-desktop",
  "version": "1.0.10",
  "private": true,
  "description": "PulseVoice desktop app \u2014 a standalone Electron shell around the PulseVoice web client (persistent tray connection for reliable inbound calls).",
  "author": "Pulse Technologies",
  "homepage": "https://www.pulsetechnologies.ai/download",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "test": "node --test \"test/*.test.js\""
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0",
    "@anthropic-ai/sdk": "^0.131.0"
  },
  "build": {
    "appId": "ai.pulsevoice.desktop",
    "productName": "PulseVoice",
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "i18n.js",
      "config.js",
      "phone.js",
      "hotkeys.js",
      "settings-store.js",
      "mini-window.js",
      "mini-preload.js",
      "mini.html",
      "mini.js",
      "share-picker.js",
      "share-sources.js",
      "share-picker-preload.js",
      "share-picker.html",
      "share-picker-page.js",
      "locales/*/common.json",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "pulsetechnologies-ai",
        "repo": "pulsevoice-desktop"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "PulseVoice-Setup.${ext}",
      "azureSignOptions": {
        "publisherName": "Pulse Payments LLC",
        "endpoint": "https://eus.codesigning.azure.net/",
        "codeSigningAccountName": "pulse-technologies",
        "certificateProfileName": "pulsevoice-desktop"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.business",
      "artifactName": "PulseVoice.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "PulseVoice uses your microphone for calls.",
        "NSCameraUsageDescription": "PulseVoice uses your camera for video calls."
      }
    },
    "linux": {
      "target": "AppImage",
      "category": "Network",
      "artifactName": "PulseVoice.${ext}"
    },
    "protocols": [
      {
        "name": "Phone links",
        "schemes": [
          "tel",
          "sip"
        ]
      }
    ]
  },
  "dependencies": {
    "@pulsetechnologies/i18n": "0.9.0",
    "electron-updater": "^6.8.11"
  }
}
